# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID of the Private Staff/Support Supergroup (starts with -100)
# TIP: Create a group with your staff, add the bot as Admin, and enable "Topics" in Group Settings!
ADMIN_GROUP_ID=-1001234567890

# Super Admin Telegram User IDs (comma separated)
SUPER_ADMINS=12345678,87654321

# Enable Telegram Forum Topics for Tickets (True/False)
USE_FORUM_TOPICS=True

# Your Web App & Community URLs
WEBAPP_URL=https://yourwebapp.example.com
OFFICIAL_CHANNEL_URL=https://t.me/your_channel
COMMUNITY_CHAT_URL=https://t.me/your_community
VIP_CHAT_URL=https://t.me/your_vip_lounge
WEBSITE_URL=https://yourwebapp.example.com

# Database Path
DATABASE_PATH=ghost_support.db
